  "dependencies": {
    "react": "^19.3.0",
    "zod": "^4.6.2",
    "zod-form-data": "3.0.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "eslint": "^9.39.5",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
