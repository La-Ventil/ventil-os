{
  "name": "@repo/form",
  "description": "Internal form state and validation helpers for Ventil O.S.",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./form-data": "./src/form-data.ts",
    "./form-errors": "./src/form-errors.ts",
    "./form-state": "./src/form-state.ts",
    "./field-state": "./src/use-field-state.ts",
    "./use-field-state": "./src/use-field-state.ts",
    "./use-field-model": "./src/use-field-model.ts",
    "./form-state-builders": "./src/form-state-builders.ts",
    "./form-action-state": "./src/form-action-state.ts",
    "./use-form-action-state": "./src/use-form-action-state.ts",
    "./use-js-enabled": "./src/use-js-enabled.ts",
    "./use-field-live-validation": "./src/use-field-live-validation.ts",
    "./use-form-field-live-validation": "./src/use-form-field-live-validation.ts",
    "./use-form-field-cross-validation": "./src/use-form-field-cross-validation.ts",
    "./form-feedback": "./src/feedback/index.ts",
    "./zod-errors": "./src/zod-errors.ts"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:dev": "eslint \"src/**/*.ts*\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "lint:staged": "pnpm exec lint-staged -c .lintstagedrc.cjs --relative --cwd ."
