{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./theme": "./src/theme.ts",
    "./fonts": "./src/fonts.tsx",
    "./*": "./src/components/*.tsx",
    "./tabs": "./src/components/tabs/index.tsx",
    "./tabs/*": "./src/components/tabs/*.tsx",
    "./admin/*": "./src/components/admin/*.tsx",
    "./admin/user-role-visual": "./src/admin/user-role-visual.tsx",
    "./forms/*": "./src/components/forms/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./menu-list": "./src/components/menu-list/index.tsx",
    "./menu-list/*": "./src/components/menu-list/*.tsx",
    "./machine/*": "./src/components/machine/*.tsx",
    "./open-badge/*": "./src/components/open-badge/*.tsx"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:dev": "eslint .",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "prettier": "prettier . --write",
    "lint:staged": "pnpm exec lint-staged -c .lintstagedrc.cjs --relative --cwd ."
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/d3-force": "^3.0.10",
    "@turbo/gen": "^2.7.6",
    "@types/react": "19.2.5",
    "eslint": "^9.34.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/x-date-pickers": "^8.0.0",
    "@repo/application": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/form": "workspace:*",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "dayjs": "^1.11.19",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "next-intl": "^4.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
