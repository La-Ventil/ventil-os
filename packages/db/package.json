{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "prisma generate && tsc",
    "clean": "rm -rf dist src/generated",
    "dev": "tsc -w",
    "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:dev": "eslint \"src/**/*.ts*\"",
    "check-types": "prisma generate && tsc --noEmit",
    "test": "jest",
    "db:migrate": "prisma migrate dev --name init",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "lint:staged": "pnpm exec lint-staged -c .lintstagedrc.cjs --relative --cwd ."
  },
  "jest": {
    "preset": "@repo/jest-presets/node"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "22.20.2",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@repo/crypto": "workspace:*",
    "@repo/domain": "workspace:*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/prisma-client.ts",
    "./read-models": "./src/read-models/index.ts",
    "./selects": "./src/selects/index.ts"
  }
}
