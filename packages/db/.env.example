# Prisma (local dev)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_shadow?schema=public"

# Security (used by app)
SECRET_PEPPER=change_me

# Seed / bootstrap (read by `pnpm db:seed`; apps/web/.env is not loaded here)
# In production, prefer disabling demo data and setting explicit admin bootstrap values.
# SEED_PASSWORD=ChangeMe123!
# SEED_INCLUDE_DEMO_DATA=0
# SEED_ADMIN_EMAIL=admin@example.org
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_FIRST_NAME=Admin
# SEED_ADMIN_LAST_NAME=Platform
# SEED_ADMIN_PASSWORD=change_me
