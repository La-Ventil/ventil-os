{
  "name": "@repo/application",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:dev": "eslint \"src/**/*.ts*\"",
    "check-types": "tsc --noEmit",
    "lint:staged": "pnpm exec lint-staged -c .lintstagedrc.cjs --relative --cwd .",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts",
    "./mocks": "./src/__mocks__/index.ts",
    "./forms": "./src/forms/index.ts",
    "./forms/*": "./src/forms/*.ts",
    "./admin/models": "./src/admin/models/index.ts",
    "./admin/models/*": "./src/admin/models/*.ts",
    "./events/models": "./src/events/models/index.ts",
    "./events/models/*": "./src/events/models/*.ts",
    "./events/usecases": "./src/events/usecases/index.ts",
    "./events/usecases/*": "./src/events/usecases/*.ts",
    "./machines/models": "./src/machines/models/index.ts",
    "./machines/models/*": "./src/machines/models/*.ts",
    "./machines/queries": "./src/machines/queries/index.ts",
    "./machines/queries/*": "./src/machines/queries/*.ts",
    "./machines/usecases": "./src/machines/usecases/index.ts",
    "./machines/usecases/*": "./src/machines/usecases/*.ts",
    "./messages/usecases": "./src/messages/usecases/index.ts",
    "./messages/usecases/*": "./src/messages/usecases/*.ts",
    "./open-badges/models": "./src/open-badges/models/index.ts",
    "./open-badges/models/*": "./src/open-badges/models/*.ts",
    "./open-badges/usecases": "./src/open-badges/usecases/index.ts",
    "./open-badges/usecases/*": "./src/open-badges/usecases/*.ts",
    "./users/models": "./src/users/models/index.ts",
    "./users/models/*": "./src/users/models/*.ts",
    "./users/account-emails": "./src/users/account-emails.ts",
    "./users/usecases": "./src/users/usecases/index.ts",
    "./users/usecases/*": "./src/users/usecases/*.ts",
    "./time/*": "./src/time/*.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@repo/crypto": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/mailer": "workspace:*",
    "@repo/storage": "workspace:*",
    "dayjs": "^1.11.19",
    "zod": "^4.1.12",
    "zod-form-data": "^3.0.1",
    "@repo/avatar-system": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "22.15.3",
    "eslint": "^9.36.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
