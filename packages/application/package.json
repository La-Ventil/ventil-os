{
  "name": "@repo/application",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:dev": "eslint \"src/**/*.ts*\"",
    "check-types": "tsc --noEmit",
    "lint:staged": "pnpm exec lint-staged -c .lintstagedrc.cjs --relative --cwd .",
    "test": "vitest",
    "test:unit": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts",
    "./mocks": "./src/__mocks__/index.ts",
    "./forms": "./src/forms/index.ts",
    "./forms/*": "./src/forms/*.ts",
    "./view-models/*": "./src/view-models/*.ts",
    "./machines/usecases": "./src/machines/usecases/index.ts",
    "./machines/usecases/*": "./src/machines/usecases/*.ts",
    "./open-badges/usecases": "./src/open-badges/usecases/index.ts",
    "./open-badges/usecases/*": "./src/open-badges/usecases/*.ts",
    "./users/usecases": "./src/users/usecases/index.ts",
    "./users/usecases/*": "./src/users/usecases/*.ts",
    "./time/*": "./src/time/*.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@repo/crypto": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/storage": "workspace:*",
    "dayjs": "^1.11.19",
    "zod": "^4.1.12",
    "zod-form-data": "^3.0.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "22.15.3",
    "eslint": "^9.36.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
