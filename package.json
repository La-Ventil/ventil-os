{
  "name": "ventil-os",
  "version": "0.0.49",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "commit": "cz",
    "dev": "turbo run dev --filter=web --filter=@repo/avatar-system",
    "i18n:report": "node scripts/generate-i18n-report.mjs",
    "metrics": "node scripts/clever-metrics.mjs",
    "start": "pnpm --filter web start",
    "lint": "turbo run lint",
    "lint:dev": "turbo run lint:dev",
    "lint:staged": "pnpm -r --workspace-concurrency 1 lint:staged",
    "check-types": "turbo run check-types",
    "prepare": "husky || true",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run",
    "release:git": "./scripts/release.sh",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:deploy": "pnpm --filter @repo/db exec prisma migrate deploy",
    "db:reset": "pnpm --filter @repo/db db:reset",
    "db:seed": "pnpm --filter @repo/db exec prisma migrate deploy && pnpm --filter @repo/db db:generate && pnpm --filter @repo/db exec prisma db seed",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:journeys": "pnpm --filter web test:e2e:journeys",
    "test:e2e:a11y": "pnpm --filter web test:e2e:a11y",
    "test:e2e:parallel": "pnpm --filter web test:e2e:parallel",
    "test:e2e:workers": "pnpm --filter web test:e2e:workers",
    "profile:web:memory": "node scripts/profile-web-memory.mjs",
    "profile:web:build-memory": "pnpm --filter web exec next build --experimental-debug-memory-usage",
    "prettier": "pnpm format",
    "dev:belle-binette": "turbo run dev --filter=belle-binette --filter=@repo/avatar-system",
    "serve:belle-binette": "pnpm --filter belle-binette build && pnpm --filter belle-binette serve"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "24.13.4",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "standard-version": "^9.5.0",
    "turbo": "^2.10.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@10.29.2",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "standard-version": {},
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "happy-dom": "^20.14.5",
      "nodemailer": "^10.0.9"
    },
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@serialport/bindings-cpp",
      "@swc/core",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
