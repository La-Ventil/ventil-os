{
  "name": "sms",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "nodemon --exec \"node -r esbuild-register ./src/index.ts\" -e .ts",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:dev": "tsc --noEmit && eslint \"src/**/*.ts*\"",
    "check-types": "echo \"skip check-types (sms)\"",
    "start": "node -r esbuild-register src/index.ts",
    "test": "jest --detectOpenHandles",
    "cli": "serialport-terminal -b 9600",
    "list": "serialport-terminal -l",
    "lint:staged": "pnpm exec lint-staged -c .lintstagedrc.cjs --relative --cwd ."
  },
  "jest": {
    "preset": "@repo/jest-presets/node"
  },
  "dependencies": {
    "@repo/logger": "workspace:*",
    "@serialport/parser-readline": "^12.0.0",
    "dotenv": "^16.6.1",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@serialport/terminal": "^12.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "22.20.2",
    "esbuild": "^0.20.2",
    "esbuild-register": "^3.6.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "typescript": "5.9.3"
  }
}
