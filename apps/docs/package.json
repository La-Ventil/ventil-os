{
  "name": "docs",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build",
    "build:gh-pages": "DOCS_EXPORT=1 next build",
    "start": "next start",
    "lint": "echo \"skip lint (docs)\"",
    "lint:dev": "echo \"skip lint:dev (docs)\"",
    "check-types": "rm -rf .next/types && tsc --noEmit",
    "lint:staged": "pnpm exec lint-staged -c .lintstagedrc.cjs --relative --cwd ."
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "typescript": "5.9.3"
  }
}
