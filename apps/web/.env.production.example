APP_NAME=La-Ventil
APP_LOCALE=fr
APP_TIME_ZONE=Europe/Paris
BASE_URL=https://your-app.cleverapps.io
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=change_me
SMTP_PASS=change_me
SMTP_SECURE=false
EMAIL_FROM=no-reply@laventil.org
CC_FS_BUCKET=/apps/web/uploads:bucket-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-fsbucket.services.clever-cloud.com
CC_HEALTH_CHECK_PATH=/api/health
CC_NODE_DEV_DEPENDENCIES=ignore
CC_POST_BUILD_HOOK=pnpm db:seed && pnpm exec turbo run build --filter=web...
CC_RUN_COMMAND=node apps/web/scripts/start-standalone.mjs
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
HUSKY=0
NEXTAUTH_SECRET=replace-with-strong-secret
NODE_ENV=production
PORT=8080
SECRET_PEPPER=replace-with-strong-secret
# Absolute path of the CC_FS_BUCKET mount (APP_HOME + mount path): the standalone server changes its cwd
UPLOADS_DIR=/home/bas/app_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/apps/web/uploads
UPLOADS_PUBLIC_PATH=/uploads
