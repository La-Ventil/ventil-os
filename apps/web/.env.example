NEXT_TELEMETRY_DISABLED=1

# Auth
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=change_me
# NEXTAUTH_URL=https://your-domain.tld/api/auth
# NEXTAUTH_URL_INTERNAL=http://internal-service

# Security
SECRET_PEPPER=change_me

# Database (docker compose)
DATABASE_URL="postgresql://ventilos:ventilos@localhost:5433/ventilos?schema=public"

# Demo users' password for e2e tests; must match SEED_PASSWORD in packages/db/.env.
# The other seed variables belong in packages/db/.env, where the seed runs.
# SEED_PASSWORD=ChangeMe123!

# Email (SMTP)
# For Mailpit (dev): SMTP_HOST=localhost, SMTP_PORT=1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=no-reply@laventil.org

# Uploads
UPLOADS_DIR=uploads
UPLOADS_PUBLIC_PATH=/uploads

# App
APP_NAME=VentilOS
APP_LOCALE=fr
APP_TIME_ZONE=Europe/Paris
BASE_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
CC_HEALTH_CHECK_PATH=/api/health

# OpenTelemetry / Uptrace (dev)
# 1. Start local Uptrace with `docker compose up -d uptrace`
# 2. Log in on http://localhost:14318 with admin@uptrace.local / admin
# 3. Create or open a project and copy its DSN from Project Settings -> Connection details
# UPTRACE_DSN=http://project1_secret_token@localhost:14318?grpc=14317
# OTEL_SERVICE_NAME=ventilos-web
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=uptrace-dsn=http://project1_secret_token@localhost:14318?grpc=14317

# Clever Cloud metrics (Warp 10), local only: read by `pnpm metrics`, never set on Clever Cloud
# Token: console -> application -> Metrics tab. Tokens expire: a 403 means regenerate it.
# WARP10_ENDPOINT=https://c2-warp10-clevercloud-customers.services.clever-cloud.com/api/v0
# WARP10_READ_TOKEN=change_me
# CLEVER_APP_ID=app_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
