NEXT_TELEMETRY_DISABLED=1

# Auth
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=change_me
# NEXTAUTH_URL=https://your-domain.tld/api/auth
# NEXTAUTH_URL_INTERNAL=http://internal-service

# Security
SECRET_PEPPER=change_me

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public"

# Seed / bootstrap
# `SEED_PASSWORD` stays useful for local dev and e2e demo users.
# In production, prefer disabling demo data and setting explicit admin bootstrap values.
# SEED_PASSWORD=ChangeMe123!
# SEED_INCLUDE_DEMO_DATA=0
# SEED_ADMIN_EMAIL=admin@example.org
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_FIRST_NAME=Admin
# SEED_ADMIN_LAST_NAME=Platform
# SEED_ADMIN_PASSWORD=change_me

# Email (SMTP)
# For Mailpit (dev): SMTP_HOST=localhost, SMTP_PORT=1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=no-reply@laventil.org

# Uploads
UPLOADS_DIR=apps/web/uploads
UPLOADS_PUBLIC_PATH=/uploads

# App
APP_NAME=VentilOS
APP_LOCALE=fr
APP_TIME_ZONE=Europe/Paris
BASE_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
CC_HEALTH_CHECK_PATH=/api/health

# OpenTelemetry / Uptrace (dev)
# 1. Start local Uptrace with `docker compose up -d uptrace`
# 2. Log in on http://localhost:14318 with admin@uptrace.local / admin
# 3. Create or open a project and copy its DSN from Project Settings -> Connection details
# UPTRACE_DSN=http://project1_secret_token@localhost:14318?grpc=14317
# OTEL_SERVICE_NAME=ventilos-web
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=uptrace-dsn=http://project1_secret_token@localhost:14318?grpc=14317
