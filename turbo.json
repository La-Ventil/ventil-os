{
  "$schema": "https://v2-7-6.turborepo.dev/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "MODEM_SERIAL_PORT_PATH",
    "MODEM_SERIAL_PORT_BAUD_RATE",
    "APP_NAME",
    "BASE_URL",
    "DATABASE_URL",
    "BREVO_API_KEY",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "SECRET_PEPPER",
    "SEED_PASSWORD",
    "SEED_INCLUDE_DEMO_DATA",
    "SEED_ADMIN_EMAIL",
    "SEED_ADMIN_USERNAME",
    "SEED_ADMIN_FIRST_NAME",
    "SEED_ADMIN_LAST_NAME",
    "SEED_ADMIN_PASSWORD",
    "UPLOADS_DIR",
    "UPLOADS_PUBLIC_PATH",
    "APP_LOCALE",
    "APP_TIME_ZONE",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_SECURE",
    "EMAIL_FROM",
    "HOST",
    "CI",
    "PORT",
    "PLAYWRIGHT_PORT",
    "NEXT_DIST_DIR",
    "PLAYWRIGHT_DB_SLOT",
    "PLAYWRIGHT_APP_LOCALE",
    "MAILPIT_BASE_URL",
    "PLAYWRIGHT_HEADED",
    "PLAYWRIGHT_WORKER_PARALLEL",
    "PLAYWRIGHT_WORKERS",
    "PLAYWRIGHT_WORKER_BASE_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "storybook-static/**"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "lint:dev": {
      "dependsOn": [
        "^lint:dev"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "prettier": {
      "dependsOn": [
        "^prettier"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
